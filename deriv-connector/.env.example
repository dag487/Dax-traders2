PORT=3000
# Optional: provide a Deriv API token for authorized endpoints
DERIV_API_TOKEN=
# Optional: override the Deriv websocket URL
DERIV_WS_URL=
# Optional basic auth (set both to enable)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Rate limiting: max requests per window (default 60)
RATE_LIMIT_MAX=60
# Window length in ms (default 60000)
RATE_LIMIT_WINDOW_MS=60000
